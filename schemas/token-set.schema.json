{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://improve.business/schemas/token-set.schema.json",
  "type": "object",
  "required": ["$schema"],
  "properties": {
    "$schema": { "type": "string", "const": "https://www.designtokens.org/schemas/2025.10/format.json" }
  },
  "additionalProperties": {
    "anyOf": [
      { "$ref": "#/$defs/group" },
      { "$ref": "#/$defs/token" }
    ]
  },
  "$defs": {
    "group": {
      "type": "object",
      "properties": { "$type": { "type": "string" } },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/group" },
          { "$ref": "#/$defs/token" }
        ]
      }
    },
    "token": {
      "type": "object",
      "required": ["$value"],
      "properties": {
        "$type": { "type": "string" },
        "$value": {}
      },
      "additionalProperties": false
    }
  }
}
