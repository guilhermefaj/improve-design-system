{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "brand": { "$type": "color", "$value": "{color.orange.500}" },
    "secondary": { "$type": "color", "$value": "{color.purple.600}" },
    "secondary-soft": { "$type": "color", "$value": "{color.purple.50}" },
    "action-primary": { "$type": "color", "$value": "{color.orange.500}" },
    "action-primary-hover": { "$type": "color", "$value": "{color.orange.400}" },
    "action-primary-active": { "$type": "color", "$value": "{color.orange.600}" },
    "action-primary-text": { "$type": "color", "$value": "{color.neutral.0}" },
    "brand-soft": { "$type": "color", "$value": "{color.orange.50}" },
    "action-text": { "$type": "color", "$value": "{color.purple.600}" },
    "canvas": { "$type": "color", "$value": "{color.neutral.0}" },
    "surface": { "$type": "color", "$value": "{color.neutral.100}" },
    "surface-raised": { "$type": "color", "$value": "{color.neutral.0}" },
    "surface-hover": { "$type": "color", "$value": "{color.neutral.50}" },
    "text": { "$type": "color", "$value": "{color.neutral.700}" },
    "text-muted": { "$type": "color", "$value": "{color.neutral.600}" },
    "text-subtle": { "$type": "color", "$value": "{color.neutral.500}" },
    "text-inverse": { "$type": "color", "$value": "{color.neutral.0}" },
    "border": { "$type": "color", "$value": "{color.neutral.200}" },
    "border-strong": { "$type": "color", "$value": "{color.neutral.400}" },
    "focus": { "$type": "color", "$value": "{color.purple.600}" },
    "overlay": { "$type": "string", "$value": "rgb(13 13 14 / 64%)" },
    "agent-thinking": { "$type": "color", "$value": "{color.purple.600}" },
    "agent-running": { "$type": "color", "$value": "{color.orange.700}" },
    "agent-awaiting": { "$type": "color", "$value": "{color.yellow.800}" },
    "agent-success": { "$type": "color", "$value": "{color.green.600}" },
    "agent-failed": { "$type": "color", "$value": "{color.red.700}" },
    "agent-paused": { "$type": "color", "$value": "{color.neutral.600}" },
    "risk-low": { "$type": "color", "$value": "{color.green.600}" },
    "risk-medium": { "$type": "color", "$value": "{color.yellow.800}" },
    "risk-high": { "$type": "color", "$value": "{color.red.700}" }
  }
}
