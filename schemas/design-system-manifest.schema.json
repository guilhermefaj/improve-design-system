{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://improve.business/schemas/design-system-manifest.schema.json",
  "title": "Improve Design System Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "source",
    "installation",
    "tokenSets",
    "components",
    "recipes",
    "maturity"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "distribution", "canonicalContract"],
      "properties": {
        "repository": { "type": "string" },
        "distribution": { "enum": ["github-source-owned"] },
        "canonicalContract": { "enum": ["manifest-and-tokens"] }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installRoot", "sharedFiles", "dependencies"],
      "properties": {
        "installRoot": { "type": "string", "minLength": 1 },
        "sharedFiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "dependencies": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "tokenSets": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "file", "platforms", "starter"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "file": { "type": "string" },
          "platforms": {
            "type": "array",
            "items": { "enum": ["react", "claude-artifact", "slides"] },
            "uniqueItems": true
          },
          "starter": { "type": "string", "minLength": 1 }
        }
      }
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentReadyPortability", "agenticUiMaturity"],
      "properties": {
        "agentReadyPortability": { "type": "number", "minimum": 0, "maximum": 10 },
        "agenticUiMaturity": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "status",
        "files",
        "exports",
        "primaryExport",
        "dependencies",
        "tokens",
        "variants",
        "states",
        "accessibility",
        "recipes",
        "maturity"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "category": {
          "enum": [
            "foundation",
            "action",
            "form",
            "feedback",
            "data-display",
            "navigation",
            "overlay",
            "marketing",
            "presentation",
            "agentic",
            "trust",
            "saas"
          ]
        },
        "status": { "enum": ["stable", "beta", "experimental", "deprecated"] },
        "description": { "type": "string" },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "exports": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "primaryExport": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tokens": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "variants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "states": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "accessibility": { "type": "array", "items": { "type": "string" } },
        "recipes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "maturity": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    }
  }
}
