{
  "name": "@improve-business/design-system",
  "version": "1.1.0",
  "description": "Design system oficial da Improve Business para produtos, landing pages e apresentações em React.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "bin": {
    "improve-ds": "./packages/cli/improve.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/improve.js",
  "module": "./dist/improve.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/improve.js",
      "default": "./dist/improve.js"
    },
    "./styles.css": "./dist/improve.css",
    "./tokens": "./src/tokens/semantic.tokens.json",
    "./tokens/primitive": "./src/tokens/primitive.tokens.json",
    "./tokens/component": "./src/tokens/component.tokens.json"
  },
  "files": [
    "dist",
    "src/components",
    "src/styles",
    "src/tokens",
    "src/index.ts",
    "packages/cli",
    "packages/artifact-kit/starters",
    "recipes",
    "schemas",
    "skills",
    "docs/MIGRATION_V0.5.md",
    "docs/MIGRATION_V0.6.md",
    "docs/MIGRATION_V1.0.md",
    "design-system.manifest.json",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs",
    "generate:check": "node scripts/generate-contracts.mjs --check",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "design:check": "node scripts/lint-design-values.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:report": "npm run build:lib && api-extractor run --local",
    "api:check": "api-extractor run --verbose",
    "test:fixtures": "node scripts/test-consumer-fixture.mjs --framework vite --react 19.2.8",
    "test:starters": "vitest run src/tests/artifact-starters.test.ts",
    "package:check": "node scripts/check-package-budget.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "check": "npm run generate:check && npm run validate:contracts && npm run design:check && npm run lint && npm run format:check && npm run test && npm run build && npm run build:lib && npm run api:check && npm run package:check"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.9",
    "@fontsource/edu-nsw-act-cursive": "^5.3.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.17.1",
    "axe-core": "^4.10.3",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
